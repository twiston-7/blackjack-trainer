{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@core/*": ["./src/blackjack/core/*"],
      "@app-types/*": ["./src/types/*"],
      "@util/*": ["./src/util/*"],
      "@strategy": ["./src/strategy/index.ts"],
      "@strategy/*": ["./src/strategy/*"],
      "@logic/*": ["./src/logic/*"],
      "@stores/*": ["./src/stores/*"],
      "@background/*": ["./src/components/background/*"],
      "@feedback/*": ["./src/components/feedback/*"],
      "@game/*": ["./src/components/game/*"],
      "@settings/*": ["./src/components/settings/*"]
    }
  },
  "include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.js"]
}
